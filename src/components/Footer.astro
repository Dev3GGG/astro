---
import Logo from "../assets/nizana.svg";
---

<footer class="footer fade-up">
    <div class="container">
        <div class="logo">
            <Logo width={250} height={90} />
            <p class="text-logo">
                Lorem Ipsum is simply dummy text of the printing and typesetting
                industry.
            </p>
        </div>

        <iframe
            src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d5288.097941672649!2d-99.16812977211595!3d20.413794372609924!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1ses!2smx!4v1757448232717!5m2!1ses!2smx"
            width="300"
            height="180"
            class="map"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>

        <div class="contacto">
            <div class="contact-title">CONTACTO</div>

            <p class="contact-line">Taxadho, Ixmiquilpan Hgo</p>

            <p class="contact-line icon">
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        fill="currentColor"
                        d="M6.62 10.79a15.05 15.05 0 006.59 6.59l2.2-2.2a1 1 0 011.01-.24c1.11.37 2.3.57 3.58.57a1 1 0 011 1V21a1 1 0 01-1 1C10.07 22 2 13.93 2 3a1 1 0 011-1h3.5a1 1 0 011 1c0 1.28.2 2.47.57 3.58a1 1 0 01-.25 1.01l-2.2 2.2z"
                    ></path>
                </svg>
                <a>+52 729 834 4852</a>
            </p>

            <p class="contact-line icon">
                <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                >
                    <path
                        fill="currentColor"
                        d="M20 4H4a2 2 0 00-2 2v12a2 2 0 002 2h16a2 2 0 002-2V6a2 2 0 00-2-2m0 4l-8 5L4 8V6l8 5 8-5z"
                    ></path>
                </svg>
                <a>nizana@gmail.com</a>
            </p>
        </div>
    </div>
</footer>

<style>
    .footer {
        background: rgba(6, 29, 101, 1);
        color: rgba(255, 255, 255, 1);
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 36px 24px;
        display: grid;
        grid-template-columns: 1.1fr 1fr 1fr;
        gap: 40px;
        align-items: center;
    }
    .container .map {
        border-radius: 20px;
    }
    .logo {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 14px 18px;
        align-items: center;
    }
    .text-logo {
        grid-column: 1;
        margin: 0;
        max-width: 270px;
        font-size: 13px;
        color: #aeb9db;
        text-align: center;
    }
    .contacto {
        justify-self: end;
        width: 100%;
        max-width: 260px;
    }
    .contact-title {
        color: white;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 10px;
    }
    .contact-line {
        margin: 0 0 10px 0;
        font-size: 14px;
        color: white;
    }
    .icon {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .icon svg {
        flex: 0 0 auto;
        opacity: 0.9;
    }
    .icon a {
        color: white;
        text-decoration: none;
    }
    .icon a:hover {
        text-decoration: underline;
    }

    @media (max-width: 920px) {
        .container {
            grid-template-columns: 1fr;
            gap: 26px;
            text-align: center;
            place-items: center;
        }
        .logo {
            grid-template-columns: 1fr;
            justify-items: center;
        }
        .contacto {
            place-items: center;
            max-width: none;
        }
    }
    @media (max-width: 600px){
        .map{
            width: 80%;
            height: auto;
        }
    }
</style>
