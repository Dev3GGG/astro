---
import image1 from "../assets/image/nizana.jpg";
import image2 from "../assets/image/mision.png";
import image3 from "../assets/image/vision.png";
import image4 from "../assets/image/valores.png";

const AUTOPLAY_MS = 7000;

const slides = [
    {
        id: "historia",
        name: "HISTORIA",
        texto: `Desde nuestros inicios hemos apostado por el diseño centrado en las personas. 
            Empezamos como un pequeño estudio y evolucionamos a un equipo multidisciplinario 
            que combina estrategia, branding y producto digital.`,
        img: image1,
    },
    {
        id: "mision",
        name: "MISIÓN",
        texto: `Nos guiamos por la innovación, la calidad y la excelencia, 
            trabajando con compromiso, responsabilidad y transparencia; 
            valoramos la colaboración, la cercanía y el aprendizaje constante,
            siempre creciendo junto a nuestros clientes y manteniendo nuestra identidad.`,
        img: image2,
    },
    {
        id: "vision",
        name: "VISIÓN",
        texto: `Convertirnos en un referente en el desarrollo de software,
            reconocido por nuestra calidad, innovación y excelencia técnica.
            Queremos ser un estudio que inspire confianza y creatividad,
            creciendo junto a nuestros clientes y consolidándonos como un aliado estratégico para pequeñas 
            y medianas empresas, transformando pequeñas ideas en grandes soluciones.`,
        img: image3,
    },
    {
        id: "valores",
        name: "VALORES",
        texto: `Nos guiamos por la innovación, la calidad y la excelencia,
            trabajando con compromiso, responsabilidad y transparencia; 
            valoramos la colaboración, la cercanía y el aprendizaje constante, 
            siempre creciendo junto a nuestros clientes y manteniendo nuestra identidad.`,
        img: image4,
    },
];
---

<section
    class="op-section fade-up"
    id="our-process"
    aria-label="CÃ³mo trabajamos"
>
    <div
        class="op-accordion"
        role="tablist"
        aria-label="Secciones de la empresa"
        data-autoplay-ms={AUTOPLAY_MS}
    >
        {
            slides.map((s, i) => (
                <article
                    class={`op-pane ${i === 0 ? "is-active" : ""}`}
                    data-index={i}
                    style={`--bg-img: url(${s.img.src});`}
                >
                    <button
                        class="op-tab"
                        id={`op-tab-${s.id}`}
                        role="tab"
                        aria-selected={i === 0 ? "true" : "false"}
                        aria-controls={`op-panel-${s.id}`}
                        tabindex={i === 0 ? "0" : "-1"}
                        data-index={i}
                    >
                        <span>{s.name}</span>
                        <span class="op-dot" aria-hidden="true" />
                    </button>

                    <div
                        id={`op-panel-${s.id}`}
                        class="op-content"
                        role="tabpanel"
                        aria-labelledby={`op-tab-${s.id}`}
                        aria-hidden={i === 0 ? "false" : "true"}
                    >
                        <div class="op-content-inner">
                            <div class="op-card-wrapper">
                                <div class="op-card">
                                    <h3>{s.name}</h3>
                                    <p>{s.texto}</p>
                                    <div
                                        class="op-progress-track"
                                        aria-hidden="true"
                                    >
                                        <div class="op-progress-fill" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </article>
            ))
        }
    </div>
</section>

<script>
    // @ts-nocheck
    function initAccordion(container) {
        if (container.dataset.opInit === "true") return;
        container.dataset.opInit = "true";

        const AUTOPLAY_MS = parseInt(
            container.dataset.autoplayMs || "7000",
            10,
        );
        const panes = Array.from(container.querySelectorAll(".op-pane"));
        const tabs = Array.from(container.querySelectorAll(".op-tab"));
        const count = panes.length;

        let active = 0;
        let paused = false;
        let timer = null;

        const prefersReducedMotion = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        );

        // ── Timer ──────────────────────────────────────────
        function startTimer() {
            clearTimeout(timer);
            // BUG FIX: no arrancar el timer si está pausado o hay reducción de movimiento
            if (paused || prefersReducedMotion.matches) return;
            timer = setTimeout(function () {
                goTo((active + 1) % count);
            }, AUTOPLAY_MS);
        }

        function stopTimer() {
            clearTimeout(timer);
            timer = null;
        }

        // ── Progress bar (visual) ──────────────────────────
        function resetBar(pane, play) {
            const fill = pane.querySelector(".op-progress-fill");
            if (!fill) return;
            fill.classList.remove("is-playing");
            void fill.offsetWidth; // fuerza reflow para reiniciar la animación CSS
            if (play && !prefersReducedMotion.matches) {
                fill.style.setProperty(
                    "--autoplay-duration",
                    AUTOPLAY_MS + "ms",
                );
                fill.classList.add("is-playing");
                fill.style.animationPlayState = paused ? "paused" : "running";
            }
        }

        // ── Core ───────────────────────────────────────────
        function goTo(index) {
            if (index < 0 || index >= count) return;
            active = index;
            panes.forEach(function (p, i) {
                const isActive = i === index;
                p.classList.toggle("is-active", isActive);
                const tab = tabs[i];
                if (tab) {
                    tab.setAttribute(
                        "aria-selected",
                        isActive ? "true" : "false",
                    );
                    tab.setAttribute("tabindex", isActive ? "0" : "-1");
                }
                const panel = p.querySelector(".op-content");
                if (panel)
                    panel.setAttribute(
                        "aria-hidden",
                        isActive ? "false" : "true",
                    );
                resetBar(p, isActive);
            });
            startTimer();
        }

        // ── Pause / Resume (solo hover y visibilidad) ─────
        function pause() {
            if (paused) return;
            paused = true;
            stopTimer();
            const fill =
                panes[active] &&
                panes[active].querySelector(".op-progress-fill");
            if (fill) fill.style.animationPlayState = "paused";
        }

        function resume() {
            if (!paused) return;
            paused = false;
            // Reiniciar la barra desde 0 y arrancar el timer
            goTo(active);
        }

        function onVisibilityChange() {
            document.hidden ? pause() : resume();
        }

        // ── Teclado ────────────────────────────────────────
        function onKeydown(e) {
            const target = e.target;
            if (!target.classList.contains("op-tab")) return;
            let next = null;
            switch (e.key) {
                case "ArrowRight":
                case "ArrowDown":
                    next = (active + 1) % count;
                    break;
                case "ArrowLeft":
                case "ArrowUp":
                    next = (active - 1 + count) % count;
                    break;
                case "Home":
                    next = 0;
                    break;
                case "End":
                    next = count - 1;
                    break;
                default:
                    return;
            }
            e.preventDefault();
            if (next !== null) {
                goTo(next);
                if (tabs[next]) tabs[next].focus();
            }
        }

        // ── Clicks ─────────────────────────────────────────
        tabs.forEach(function (btn) {
            btn.addEventListener("click", function (e) {
                e.stopPropagation();
                // BUG FIX: si estaba pausado por hover, reanudar antes de cambiar
                paused = false;
                goTo(parseInt(btn.dataset.index || "0", 10));
            });
        });

        panes.forEach(function (pane, idx) {
            pane.style.cursor = "pointer";
            pane.addEventListener("click", function (e) {
                if (e.target.closest("a, button, input, textarea, select"))
                    return;
                // BUG FIX: si estaba pausado por hover, reanudar antes de cambiar
                paused = false;
                goTo(idx);
            });
        });

        // ── Eventos: solo hover y visibilidad ─────────────
        // BUG FIX: se eliminó focusin/focusout porque causaba quedar pausado
        // permanentemente al hacer click dentro del acordeón.
        container.addEventListener("mouseenter", pause);
        container.addEventListener("mouseleave", resume);
        document.addEventListener("visibilitychange", onVisibilityChange);
        container.addEventListener("keydown", onKeydown);

        prefersReducedMotion.addEventListener("change", function () {
            prefersReducedMotion.matches ? stopTimer() : goTo(active);
        });

        const c = container;
        c.__opCleanup = function () {
            stopTimer();
            document.removeEventListener(
                "visibilitychange",
                onVisibilityChange,
            );
            container.removeEventListener("keydown", onKeydown);
            container.removeEventListener("mouseenter", pause);
            container.removeEventListener("mouseleave", resume);
            container.removeAttribute("data-op-init");
        };

        goTo(0);
    }

    function boot() {
        const el = document.querySelector(".op-accordion");
        if (!el) return;
        const c = el;
        if (c.__opCleanup) c.__opCleanup();
        initAccordion(el);
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", boot, { once: true });
    } else {
        boot();
    }
    document.addEventListener("astro:page-load", boot);
</script>

<style>
    .op-section {
        margin: 10px 0 50px 0;
        display: flex;
        justify-content: center;
        width: 100%;
    }

    .op-accordion {
        width: min(1300px, 100%);
        min-height: 420px;
        display: flex;
        flex-direction: row;
        gap: 10px;
        padding: 0 15px;
    }

    .op-pane {
        position: relative;
        flex: 1;
        overflow: hidden;
        border-radius: 16px;
        background: #0b1222;
        color: #eef2ff;

        transition: flex 0.5s cubic-bezier(0.25, 1, 0.5, 1);
        display: flex;
        flex-direction: column;
    }

    .op-pane.is-active {
        flex: 3;
    }

    .op-pane::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: 0;
        background-image: var(--bg-img);
        background-size: cover;
        background-position: center;
        opacity: 0.45;
        transition: opacity 0.5s ease;
    }

    .op-pane.is-active::before {
        opacity: 0.7;
    }

    .op-tab {
        position: absolute;
        inset: 0;
        z-index: 2;
        background: transparent;
        color: #fff;
        padding: 20px 16px;
        cursor: pointer;
        border: none;
        text-align: left;
        font-weight: 700;
        font-size: clamp(12px, 1.6vw, 14px);
        letter-spacing: 0.3px;
        display: flex;
        align-items: flex-end;
        justify-content: flex-start;
        gap: 10px;
        writing-mode: vertical-rl;
        text-orientation: mixed;
        transform: rotate(180deg);
        transition:
            opacity 0.3s ease,
            visibility 0.3s;
    }

    .op-tab:focus-visible {
        outline: 2px solid #7c8bd6;
        outline-offset: -4px;
        border-radius: 12px;
    }

    .op-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: transparent;
        border: 1px solid #dbe3ff;
    }

    .op-pane.is-active .op-tab {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    .op-content {
        position: relative;
        z-index: 1;
        flex: 1;
        display: grid;
        grid-template-rows: 0fr;
        align-content: center;
        transition: grid-template-rows 0.5s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .op-pane.is-active .op-content {
        grid-template-rows: 1fr;
    }

    .op-content-inner {
        overflow: hidden;
        min-height: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transform: translateY(15px);
        transition:
            opacity 0.4s ease,
            transform 0.4s ease;
    }

    .op-pane.is-active .op-content-inner {
        opacity: 1;
        transform: translateY(0);
        transition-delay: 0.1s;
    }

    .op-card-wrapper {
        padding: 30px;
        width: 100%;
        max-width: 500px;
    }

    .op-card {
        background: rgba(22, 30, 50, 0.85);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 14px;
        padding: 24px;
        position: relative;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .op-card h3 {
        margin: 0 0 8px;
        font-size: clamp(18px, 2vw, 22px);
        color: #dbe3ff;
    }

    .op-card p {
        margin: 0 0 16px;
        line-height: 1.55;
        font-size: clamp(14px, 1vw, 16px);
        color: rgba(255, 255, 255, 0.9);
    }

    .op-progress-track {
        width: 100%;
        height: 3px;
        background: rgba(255, 255, 255, 0.12);
        border-radius: 10px;
        overflow: hidden;
    }

    .op-progress-fill {
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, #7c8bd6, #a1b0ff);
        border-radius: 10px;
        transform-origin: left center;
        transform: scaleX(0);
        will-change: transform;
    }

    .op-progress-fill.is-playing {
        animation: op-fillBar var(--autoplay-duration, 7000ms) linear;
    }

    @keyframes op-fillBar {
        from {
            transform: scaleX(0);
        }
        to {
            transform: scaleX(1);
        }
    }

    @media (max-width: 900px) {
        .op-accordion {
            display: grid;
            grid-template-columns: 1fr 1fr;
            grid-auto-rows: minmax(260px, auto);
            min-height: auto;
        }

        .op-pane {
            flex: none;
        }

        .op-tab {
            writing-mode: initial;
            transform: none;
            align-items: center;
            padding: 14px 16px;
            height: 60px;
            bottom: auto;
        }

        .op-pane.is-active .op-tab {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            position: relative;
        }

        .op-card-wrapper {
            padding: 15px;
        }

        .op-card {
            padding: 18px;
        }
    }

    @media (max-width: 640px) {
        .op-accordion {
            display: flex;
            flex-direction: column;
        }

        .op-pane {
            min-height: 60px;
        }

        .op-pane.is-active {
            flex: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .op-pane,
        .op-pane::before,
        .op-tab,
        .op-content,
        .op-content-inner,
        .op-progress-fill {
            transition: none !important;
            animation: none !important;
        }
    }
</style>
