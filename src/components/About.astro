            font-size: 40px;
        }

        .global-headline-div.is-sticky {
            top: 15vh;
        }

        .voices-div {
            row-gap: 8rem;
            margin-top: 15vh;
        }

        .voices-item {
            padding: 1.5rem;
            max-width: 84%;
        }

        .avatar-img {
            width: 3.5rem;
            height: 3.5rem;
        }

        .global-headline-xxs {
            font-size: 18px;
            font-weight: 600;
            color: white;
        }

        .copytext {
            font-size: 13px;
        }
    }
</style>
