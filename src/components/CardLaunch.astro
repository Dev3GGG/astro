---
import { Image } from "astro:assets";

interface Props {
    id: number;
    title: string;
    price: number;
    image: string;
}

const { id, title, price, image } = Astro.props;
---

<div class="cards">
    <p>{title}</p>
    <Image src={image} alt={title} width={200} height={200} />
    <p class="price">${price} USD</p>
</div>

<style>
    .cards {
        background: rgb(255, 255, 255);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 25px;
        border-radius: 15px;
        text-align: center;
        align-items: center;
        box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        transition:
            transform 0.4s ease,
            box-shadow 0.4s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        animation: slideUp 0.6s ease-in-out;
        gap: 10px;
    }
    .cards:hover {
        transform: translateY(-8px);
        box-shadow: 0 12px 24px rgba(255, 153, 0, 0.4);
    }
    .cards p {
        margin: 0 0;
        font-size: 17px;
        font-weight: bolder;
    }
    .price {
        color: #3f6c9e;
    }
    img {
        max-width: 90%;
        height: 250px;
        object-fit: contain;
        margin-bottom: 10px;
    }
</style>
