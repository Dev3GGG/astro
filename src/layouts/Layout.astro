---
import Footer from "@components/Footer.astro";
import Nav from "@components/Nav.astro";

interface Props {
	title: string;
}
const { title } = Astro.props;
const links = [
	{ label: "INICIO", href: "#home" },
	{ label: "SERVICIOS", href: "#services" },
	{ label: "CÓMO TRABAJAMOS", href: "#our-process" },
	{ label: "NOSOTROS", href: "#about" },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/src/assets/nizana.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Nav links={links} />
		<main>
			<slot />
		</main>
		<Footer links={links} />
	</body>
</html>
<script lang="ts">
	let currentScrollAnimation;

	const scrooll_behavior = (objective_Y, duration = 1000) => {
		const easeInOutCubic = (t) => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
		if (currentScrollAnimation) {
			cancelAnimationFrame(currentScrollAnimation);
		}
		const startY = window.scrollY;
		const difference = objective_Y - startY;
		let start_time;
		const cancelScroll = () => {
			if (currentScrollAnimation) {
				cancelAnimationFrame(currentScrollAnimation);
				currentScrollAnimation = null;
			}
			window.removeEventListener("wheel", cancelScroll);
			window.removeEventListener("touchmove", cancelScroll);
		};

		window.addEventListener("wheel", cancelScroll, { passive: true });
		window.addEventListener("touchmove", cancelScroll, { passive: true });

		const step = (estimated_time) => {
			if (!start_time) start_time = estimated_time;
			const time = estimated_time - start_time;
			let percent = Math.min(time / duration, 1);
			percent = easeInOutCubic(percent);

			window.scrollTo(0, startY + difference * percent);

			if (time < duration) {
				currentScrollAnimation = requestAnimationFrame(step);
			} else {
				window.removeEventListener("wheel", cancelScroll);
				window.removeEventListener("touchmove", cancelScroll);
				currentScrollAnimation = null;
			}
		};

		currentScrollAnimation = requestAnimationFrame(step);
	};

	document.querySelectorAll("a[href^='#']").forEach((enlaces) => {
		enlaces.addEventListener("click", function (e) {
			e.preventDefault();
			const target = document.querySelector(this.getAttribute("href"));
			if (target) {
				const targetPosition = target.getBoundingClientRect().top + window.scrollY - 64;
				scrooll_behavior(targetPosition, 1000);
			}
		});
	});
	document.addEventListener("DOMContentLoaded", () => {
		const toggle = document.getElementById("icon-menu");
		const menuLinks = document.querySelectorAll("#menu-open a");

		menuLinks.forEach((link) => {
			link.addEventListener("click", () => {
				if (toggle) toggle.checked = false;
			});
		});
	});
</script>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html,
	body {
		font-family: "Montserrat Variable", sans-serif;
		font-weight: 400;
		scroll-padding-top: 60px;
		padding: 0;
		margin: 0;
		width: 100%;
		height: 100%;
		overflow-x: hidden;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	main {
		place-items: center;
	}
	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>
